# --- API (optional, defaults are built in) ---
API_BASE_URL_1=https://api.api-store.workers.dev/api/bazardor
API_BASE_URL_2=https://api.abcz.workers.dev/api/bazardor

# --- Better Auth ---
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Local: http://localhost:3000   |   Production: your deployed URL
BETTER_AUTH_URL=http://localhost:3000

# --- MongoDB (Atlas free tier works) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=bazardor

# --- Social login (leave blank to hide the provider's backend) ---
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
